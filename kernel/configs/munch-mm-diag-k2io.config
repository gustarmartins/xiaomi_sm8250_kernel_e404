# K2-I/O blocked-writer forensics for munch.
#
# Merge after the complete, boot-proven K1f diagnostic chain:
#   make O=out vendor/munch_defconfig munch-mm-diag.config \
#        munch-mm-diag-k1a.config munch-mm-diag-k1b.config \
#        munch-mm-diag-k1c.config munch-mm-diag-k1f.config \
#        munch-mm-diag-k2io.config
#
# The 2026-07-25 dark-panel incident left unrelated /data writers in D state
# for roughly ten minutes. Tracepoints showed balance_dirty_pages() applying
# a zero task ratelimit while global Writeback stayed near 87 MiB, but K1f
# could not dump blocked task stacks: MAGIC_SYSRQ was absent and DEBUG_FS
# remained in the unisolated K1 bootloop suspect set.
#
# This fragment adds the smallest useful attribution set without enabling
# DEBUG_FS, PAGE_OWNER, list/VM assertions, function tracing, lockdep, or
# block blktrace. Existing tracefs writeback, block and F2FS tracepoints stay
# available through the boot-proven FTRACE configuration.

# Root can write 'w', 't', 'l' or 'm' to /proc/sysrq-trigger even while the
# keyboard/serial SysRq interface remains disabled by default. This gives
# pstore/dmesg an exact blocked-task snapshot when ADB is still responsive.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CONFIG_MAGIC_SYSRQ_SERIAL is not set

# Attribute time spent waiting for synchronous block I/O, swap-in and page
# reclaim through taskstats. TASKSTATS and TASK_IO_ACCOUNTING are already
# present in the munch daily defconfig.
CONFIG_TASK_DELAY_ACCT=y

# Report a worker pool that makes no progress for the kernel's bounded
# watchdog interval. This emits evidence; it does not add a new panic policy.
CONFIG_WQ_WATCHDOG=y

# Keep the unresolved bootloop suspects and high-overhead interfaces out of
# this build. F2FS_STAT_FS and BLK_DEV_IO_TRACE both require DEBUG_FS here;
# the existing F2FS/block trace events provide the passive I/O timeline.
# CONFIG_DEBUG_FS is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_F2FS_STAT_FS is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_PANIC_ON_WARN is not set

# DEBUG_FS selected Qualcomm idle statistics in the original K1 merge. K1c
# later disabled DEBUG_FS, but its selected statistics survived in the
# effective K2 config. Return this unrelated instrumentation to the daily
# munch default instead of carrying accidental overhead into K2-I/O.
# CONFIG_MSM_IDLE_STATS is not set
