# K36 lock-dependency qualification fragment for Poco F4 (munch).
#
# Merge after vendor/munch_defconfig and munch-k14-mm-diag.config. This image
# exists only to expose lock-order, atomic-sleep, and recursive-lock defects in
# the MGLRU/reclaim/camera paths. It is intentionally not a daily-driver config.

CONFIG_PROVE_LOCKING=y
CONFIG_LOCK_STAT=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_LOCK_ALLOC=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_WW_MUTEX_SLOWPATH=y

# A warning must remain recoverable long enough to reach pstore/log capture.
# CONFIG_PANIC_ON_WARN is not set

# Keep previously rejected broad MM validators out of this isolated arm.
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_KASAN is not set
