# K1g boot-enabled MGLRU freeze-forensics trial for munch.
#
# Merge after the complete, boot-proven K1f diagnostic chain. K1g changes
# exactly one kernel policy: MGLRU core + page-table walking start enabled
# during kernel boot, so no live classic-LRU <-> MGLRU list conversion is
# performed before the workload.
#
# The source default for lru_gen_min_ttl remains 0. K1f's hung-task and
# soft-lockup panic capture remains unchanged.

CONFIG_LRU_GEN_ENABLED=y
