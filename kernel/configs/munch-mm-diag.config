# munch memory-diagnostic build fragment (K0, 2026-07-23).
#
# Merge on top of the daily defconfig:
#   make O=out vendor/munch_defconfig munch-mm-diag.config
#
# Purpose: catch the shrink_page_list LIST_POISON corruption at the
# corrupting call site (double list_add/list_del of page->lru) instead of
# panicking later at the victim, and give reclaim/compaction/OOM visibility
# through event tracepoints. Everything here is either compile-time checks
# with modest overhead or runtime-gated (page_owner=on boot param, tracefs
# event toggles). Page poisoning and KASAN are deliberately excluded; they
# are separate heavier variants per the K0 plan.
#
# None of these options change vermagic or the kernel release string, so
# vendor module loading is unaffected.

# Gate for the debug options below (off in the daily defconfig); debugfs
# is required by the page_owner read interface.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y

# List corruption: WARN + refuse the corrupt op at the culprit's call site.
# BUG_ON_DATA_CORRUPTION stays off so a detection survives for log capture.
CONFIG_DEBUG_LIST=y
# CONFIG_BUG_ON_DATA_CORRUPTION is not set

# VM_BUG_ON_PAGE sanity checks throughout mm/ (isolation, putback, LRU
# flag discipline). Turns silent state violations into immediate reports.
CONFIG_DEBUG_VM=y
# CONFIG_DEBUG_VM_VMACACHE is not set
# CONFIG_DEBUG_VM_RB is not set
# CONFIG_DEBUG_VM_PGFLAGS is not set

# Allocation attribution (inert until page_owner=on is passed on cmdline).
CONFIG_PAGE_EXTENSION=y
CONFIG_PAGE_OWNER=y

# Event tracing: mm_vmscan_*, compaction, oom tracepoints via tracefs.
# The daily kernel ships with CONFIG_FTRACE off, which left every prior
# investigation blind to reclaim internals. No function hooks are enabled,
# so overhead is negligible while events are off.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_STACKTRACE=y

# MGLRU generation counters in /sys/kernel/mm/lru_gen for the K1 A/B runs.
CONFIG_LRU_GEN_STATS=y
