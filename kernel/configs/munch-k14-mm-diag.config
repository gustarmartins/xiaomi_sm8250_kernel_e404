# K14 boot-tolerant MM/camera-stall diagnostic fragment for munch.
#
# Merge after vendor/munch_defconfig. This carries forward the trace and
# lockup detector set that completed RAM-only and persistent boots in K1f,
# plus the K2-I/O SysRq/delay/workqueue attribution set. It deliberately does
# not re-enable DEBUG_LIST, DEBUG_VM, PAGE_OWNER, or DEBUG_FS: the earlier K1,
# K1a, and K1b images containing those global vendor-tree checks reset before
# Android booted. Those remain a separate heavy qualification experiment.

# Keep MGLRU active from boot; K14 fixes runtime switching, but the camera
# comparison must not introduce conversion as an uncontrolled variable.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y

# Event tracing only. Function instrumentation stays off.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_STACKTRACE=y
CONFIG_KALLSYMS=y
CONFIG_PSI_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_UPROBE_EVENTS is not set

# Turn a silent MM livelock or blocked I/O path into persistent evidence.
CONFIG_DEBUG_KERNEL=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# CONFIG_HARDLOCKUP_DETECTOR is not set

# Root-triggered blocked-task/CPU/memory dumps and passive delay attribution.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
CONFIG_TASK_DELAY_ACCT=y
CONFIG_WQ_WATCHDOG=y

# Do not inherit unrelated debug overhead from DEBUG_KERNEL defaults.
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PANIC_ON_WARN is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_F2FS_STAT_FS is not set
# CONFIG_MSM_IDLE_STATS is not set
