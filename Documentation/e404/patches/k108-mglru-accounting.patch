+atomic_long_t lru_gen_size_underflow = ATOMIC_LONG_INIT(0);
+atomic_long_t lru_gen_size_underflow_pages = ATOMIC_LONG_INIT(0);
+atomic_long_t lru_gen_underflow_delete = ATOMIC_LONG_INIT(0);
