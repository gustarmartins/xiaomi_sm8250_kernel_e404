 	if (i == len)
 		return -ENOIOCTLCMD;
 
-	if (_IOC_SIZE(cmds[i].cmd > sizeof(data))) {
+	if (_IOC_SIZE(cmds[i].cmd) > sizeof(data)) {
 		dev_err_ratelimited(dev_priv->device->dev,
